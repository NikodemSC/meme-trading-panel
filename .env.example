# Opcjonalnie: własny dostawca danych Solana dla skanera.
SOLANA_RPC_URL=https://twoj-rpc-solana.example
SOLANA_WS_URL=wss://twoj-websocket-solana.example

# Przy zakładaniu pierwszego konta na publicznym serwerze ustaw silny,
# jednorazowy kod. Na localhost nie jest wymagany.
# MEME_PILOT_SETUP_CODE=

# Po podłączeniu trwałego dysku na hostingu ustaw katalog danych na jego ścieżkę.
# MEME_PILOT_DATA_DIR=

# Dokładny adres hosta panelu, bez ścieżki i końcowego ukośnika.
# Np. https://twoj-login.github.io (również gdy strona ma ścieżkę /meme-pilot/).
# MEME_PILOT_FRONTEND_ORIGINS=https://twoj-login.github.io

# Trwały zapis publicznego portfela Menadżera/Paper/Copy w Supabase.
# Klucz secret/service_role trzymaj wyłącznie w zmiennych Rendera, nigdy w GitHubie.
# SUPABASE_URL=https://nbopyufqyvbpjuzpysxq.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...

